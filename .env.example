# Copy this file to `.env` and fill in your real key.
# NEVER commit the real .env file.

APP_ORIGIN=http://127.0.0.1:8765
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-bytes
IP_HASH_SECRET=replace-with-a-different-random-secret

# Supabase: publishable key is used only for Auth calls; secret/service key stays server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Transactional recovery email.
RESEND_API_KEY=re_your-server-only-key
EMAIL_FROM=Capy English <contato@example.com>

# Webhooks and scheduled jobs. Never place these values in URLs.
KIWIFY_WEBHOOK_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-random-secret

# Your OpenAI API key (starts with sk-proj- or sk-)
OPENAI_API_KEY=sk-proj-your-key-here

# (optional) Which OpenAI model to use. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# (optional) Port for the local server. Default: 8765
PORT=8765

# OpenRouter (opcional): roteia chat/completions por la em vez da OpenAI.
# Audio (TTS, Whisper, Realtime) continua exigindo OPENAI_API_KEY.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Qualquer modelo do catalogo OpenRouter. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
