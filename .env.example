# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env file. In production, set these in Vercel → Settings → Environment Variables.

# ── Required ─────────────────────────────────────────────────────────────────
# Signs the login cookie. Any long random string (min 16 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Supabase (service role key — server-side only, never in the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# OpenAI (starts with sk-proj- or sk-)
OPENAI_API_KEY=sk-proj-your-key-here

# ── E-mail (magic link) ──────────────────────────────────────────────────────
# Without RESEND_API_KEY production refuses to send links (local dev shows them on screen).
RESEND_API_KEY=
EMAIL_FROM=Capy English <no-reply@capyenglish.com.br>
# Base URL used inside e-mail links (default: https://www.capyenglish.com.br)
APP_URL=

# ── Admin / payments ─────────────────────────────────────────────────────────
# Key for admin.html and teacher_homework.html (min 8 chars, sent as X-Admin-Key)
TEACHER_KEY=
KIWIFY_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
PORT=8765
# Extra origins allowed to POST to the API (comma-separated), e.g. a new domain
ALLOWED_ORIGINS=

# ── Local dev without a database ─────────────────────────────────────────────
# npm run mock:db   → then use:
# SUPABASE_URL=http://localhost:54321
# SUPABASE_KEY=dev
