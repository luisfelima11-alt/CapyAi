# Copy this file to `.env` and fill in your real key.
# NEVER commit the real .env file.

# Your OpenAI API key (starts with sk-proj- or sk-)
OPENAI_API_KEY=sk-proj-your-key-here

# (optional) Which OpenAI model to use. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# (optional) Port for the local server. Default: 8765
PORT=8765
