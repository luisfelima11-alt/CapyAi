  "quiz": [
    {
      "q": "\"Eu sou o Luan.\"",
      "opts": [
        "I am Luan.",
        "I Luan.",
        "I is Luan.",
        "Am I Luan."
      ],
      "a": "I am Luan.",
      "rule": "Em inglês o verbo nunca some. E com I é sempre am."
    },
    {
      "q": "Qual é a forma curta de \"you are\"?",
      "opts": [
        "you're",
        "your",
        "you'r",
        "youre"
      ],
      "a": "you're",
      "rule": "O apóstrofo entra no lugar da letra que sumiu: you a̶re → you're. Cuidado: your é \"seu\"."
    },
    {
      "q": "\"Você é o Luan?\"",
      "opts": [
        "Are you Luan?",
        "You are Luan?",
        "Do you are Luan?",
        "Is you Luan?"
      ],
      "a": "Are you Luan?",
      "rule": "Para perguntar, o verbo vai para a frente. Não se usa do com to be."
    },
    {
      "q": "\"Eu não sou de São Paulo.\"",
      "opts": [
        "I'm not from São Paulo.",
        "I not am from São Paulo.",
        "I don't am from São Paulo.",
        "I'm no from São Paulo."
      ],
      "a": "I'm not from São Paulo.",
      "rule": "O not vem depois do verbo to be. E don't nunca anda com to be."
    },
    {
      "q": "\"Quantos anos você tem?\"",
      "opts": [
        "How old are you?",
        "How many years do you have?",
        "How old do you have?",
        "How much old are you?"
      ],
      "a": "How old are you?",
      "rule": "Em inglês você não TEM anos, você É velho: How old ARE you? — I AM 21."
    },
    {
      "q": "Jack é americano. Como você diz isso?",
      "opts": [
        "He is American.",
        "He are American.",
        "He American.",
        "His is American."
      ],
      "a": "He is American.",
      "rule": "he / she / it sempre pedem is."
    },
    {
      "q": "\"Este trator é grande.\"",
      "opts": [
        "This tractor is big.",
        "This tractor big.",
        "This tractor are big.",
        "This is tractor big."
      ],
      "a": "This tractor is big.",
      "rule": "tractor é uma coisa só (it), então is. E o adjetivo big vem depois do verbo."
