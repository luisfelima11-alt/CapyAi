{"id":7,"title":"Past Simple — Regular Verbs","emoji":"⏪","verbs":["Worked","Played","Studied","Watched"],"vocab":[{"en":"Yesterday","pt":"Ontem"},{"en":"Last week","pt":"Semana passada"},{"en":"Last year","pt":"Ano passado"},{"en":"Ago","pt":"Atrás"},{"en":"Then","pt":"Então/Depois"},{"en":"Before","pt":"Antes"},{"en":"After","pt":"Depois"},{"en":"While","pt":"Enquanto"},{"en":"When","pt":"Quando"},{"en":"During","pt":"Durante"},{"en":"Travel","pt":"Viagem/Viajar"},{"en":"Visit","pt":"Visitar"},{"en":"Talk","pt":"Conversar"},{"en":"Call","pt":"Ligar"},{"en":"Walk","pt":"Caminhar"},{"en":"Open","pt":"Abrir"},{"en":"Close","pt":"Fechar"},{"en":"Start","pt":"Começar"},{"en":"Finish","pt":"Terminar"},{"en":"Use","pt":"Usar"},{"en":"Help","pt":"Ajudar"},{"en":"Try","pt":"Tentar"},{"en":"Stop","pt":"Parar"},{"en":"Wait","pt":"Esperar"},{"en":"Return","pt":"Retornar"},{"en":"Clean","pt":"Limpar"},{"en":"Cook","pt":"Cozinhar"},{"en":"Learn","pt":"Aprender"},{"en":"Listen","pt":"Ouvir"},{"en":"Watch","pt":"Assistir"}],"expressions":[{"expr":"Back in the day.","meaning":"Antigamente / Na época.","example":"Back in the day, we walked to school."},{"expr":"Once upon a time.","meaning":"Era uma vez.","example":"Once upon a time, I lived in another city."},{"expr":"It's history now.","meaning":"Isso é passado.","example":"We had a fight but it's history now."},{"expr":"Long story short.","meaning":"Resumindo.","example":"Long story short, I missed the bus yesterday."}],"sentences":["I worked all day yesterday.","She studied English last year.","We watched a movie last night.","He called his mother yesterday.","They traveled to another city.","I finished the project last week.","She opened the door and walked in.","We talked for two hours."],"grammar":{"title":"Simple Past — Verbos Regulares","rules":["Adicione <b>-ed</b> ao infinitivo: work → work<b>ed</b>, call → call<b>ed</b>","Verbos terminados em -e: adicione apenas <b>-d</b>: use → use<b>d</b>, close → close<b>d</b>","Verbos terminados em consoante+y: troque y por <b>-ied</b>: study → stud<b>ied</b>","Para negar: <b>didn't</b> + verbo no infinitivo: I didn't work.","Para perguntar: <b>Did</b> + sujeito + infinitivo: Did you work?"],"table":{"headers":["Afirmativo","Negativo","Pergunta"],"rows":[["I worked.","I didn't work.","Did you work?"],["She studied.","She didn't study.","Did she study?"],["They watched.","They didn't watch.","Did they watch?"]]}},"quiz":[{"q":"I ___ English last year. (study)","a":"studied","opts":["studyed","studied","study","studying"]},{"q":"She ___ her friend yesterday. (call)","a":"called","opts":["call","calls","called","calling"]},{"q":"They ___ work last week. (negative)","a":"didn't","opts":["don't","doesn't","didn't","wasn't"]},{"q":"___ you watch the movie? (question)","a":"Did","opts":["Do","Does","Did","Have"]},{"q":"He ___ the door and walked in. (open)","a":"opened","opts":["open","opens","opened","opening"]}],"speak":["I worked yesterday.","Did you study last night?","She called her mother.","We didn't watch TV.","They traveled last year."],"lang":"en"}