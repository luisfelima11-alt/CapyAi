","Do I go?"],["You","You go","You don't go","Do you go?"],["He/She","He goes","He doesn't go","Does he go?"],["We","We go","We don't go","Do we go?"],["They","They go","They don't go","Do they go?"]]}},"quiz":[{"q":"He ___ to the room.","a":"goes","opts":["go","goes","do","see"]},{"q":"She ___ the story.","a":"says","opts":["say","see","says","goes"]},{"q":"___ you go to school?","a":"Do","opts":["Does","Do","Is","Are"]},{"q":"He ___ go to work. (negative)","a":"doesn't","opts":["don't","doesn't","isn't","aren't"]},{"q":"They ___ the school.","a":"see","opts":["sees","go","see","do"]}],"speak":["I go to school.","Does she go to work?","They don't see the problem.","He does his homework.","We say the truth."],"lang":"en"}