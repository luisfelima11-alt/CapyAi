{"id":211,"title":"Les Vêtements","emoji":"🛍️","lang":"fr","verbs":["Porter","Acheter","Essayer","Choisir"],"vocab":[{"en":"Un pantalon","pt":"Uma calça"},{"en":"Une chemise","pt":"Uma camisa"},{"en":"Une robe","pt":"Um vestido"},{"en":"Des chaussures","pt":"Sapatos"},{"en":"Un manteau","pt":"Um casaco"},{"en":"Porter","pt":"Vestir / Usar"},{"en":"La taille","pt":"O tamanho"},{"en":"C'est combien ?","pt":"Quanto custa?"}],"expressions":[{"expr":"Je peux essayer ?","meaning":"Posso provar?","example":"Cette robe, je peux essayer ?"},{"expr":"Ça vous va bien","meaning":"Fica bem em você.","example":"Cette chemise, ça vous va bien !"},{"expr":"C'est trop cher","meaning":"É muito caro.","example":"Non merci, c'est trop cher."},{"expr":"Quelle est votre taille ?","meaning":"Qual é o seu tamanho?","example":"Quelle est votre taille, monsieur ?"}],"sentences":["Je porte un pantalon noir.","Elle achète une robe rouge.","Tu essaies les chaussures.","Il fait froid, je mets un manteau.","Cette chemise est belle.","C'est combien, ce pantalon ?","Quelle est votre taille ?","J'aime cette robe bleue."],"grammar":{"title":"Os Verbos em -ER no Presente","rules":["A maioria dos verbos franceses termina em <b>-er</b> (porter, acheter, aimer).","Retire o -er e adicione: <b>-e, -es, -e, -ons, -ez, -ent</b>.","Exemplo: porter → je porte, tu portes, il porte, nous portons, vous portez, ils portent."],"table":{"headers":["Pronome","Porter","Acheter"],"rows":[["je","porte","achète"],["tu","portes","achètes"],["il / elle","porte","achète"],["nous","portons","achetons"],["vous","portez","achetez"],["ils / elles","portent","achètent"]]}},"quiz":[{"q":"Como se diz 'uma camisa' ?","a":"Une chemise","opts":["Un pantalon","Une chemise","Une robe","Un manteau"]},{"q":"Como perguntar 'quanto custa' ?","a":"C'est combien ?","opts":["C'est quoi ?","C'est combien ?","C'est où ?","C'est qui ?"]},{"q":"'Je ___ un pantalon.' (vestir)","a":"porte","opts":["porter","porte","portes","portons"]},{"q":"Como se diz 'sapatos' ?","a":"Des chaussures","opts":["Un manteau","Des chaussures","Une robe","Un pantalon"]},{"q":"'Nous ___ des vêtements.' (comprar)","a":"achetons","opts":["achète","achetez","achetons","achètent"]}],"speak":["Je porte une chemise bleue.","C'est combien, ce pantalon ?","Je peux essayer cette robe ?","Quelle est votre taille ?","J'achète un manteau noir."]}