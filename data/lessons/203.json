{"id":203,"title":"Les Couleurs","emoji":"🎨","lang":"fr","verbs":["Voir","Peindre","Choisir","Aimer"],"vocab":[{"en":"Rouge","pt":"Vermelho"},{"en":"Bleu","pt":"Azul"},{"en":"Vert","pt":"Verde"},{"en":"Jaune","pt":"Amarelo"},{"en":"Noir","pt":"Preto"},{"en":"Blanc","pt":"Branco"},{"en":"Rose","pt":"Rosa"},{"en":"Orange","pt":"Laranja"}],"expressions":[{"expr":"Voir la vie en rose","meaning":"Ver a vida cor de rosa.","example":"Depuis hier, je vois la vie en rose."},{"expr":"Être rouge comme une tomate","meaning":"Ficar vermelho como tomate.","example":"Il est rouge comme une tomate !"},{"expr":"Avoir une peur bleue","meaning":"Ter muito medo.","example":"J'ai une peur bleue des araignées."},{"expr":"Nuit blanche","meaning":"Noite em claro.","example":"J'ai passé une nuit blanche."}],"sentences":["La voiture est rouge.","Le ciel est bleu.","L'herbe est verte.","Le soleil est jaune.","Le chat est noir.","La maison est blanche.","J'aime la couleur rose.","L'orange est ma couleur préférée."],"grammar":{"title":"Concordância das Cores (Adjetivos)","rules":["As cores são <b>adjetivos</b> e concordam em gênero e número com o substantivo.","Masculino → <b>vert</b> | Feminino → <b>verte</b> | Plural → <b>verts/vertes</b>.","<b>Rose, orange, jaune</b> são invariáveis no singular: une robe rose, une fleur orange."],"table":{"headers":["Masculino","Feminino","Tradução"],"rows":[["noir","noire","preto/preta"],["blanc","blanche","branco/branca"],["vert","verte","verde"],["bleu","bleue","azul"]]}},"quiz":[{"q":"Como se diz 'vermelho' em francês?","a":"Rouge","opts":["Rose","Rouge","Orange","Jaune"]},{"q":"Qual é o feminino de 'blanc' ?","a":"Blanche","opts":["Blanc","Blanche","Blancs","Blanches"]},{"q":"'Le ciel est ___' (azul)","a":"bleu","opts":["bleue","bleu","blanc","noir"]},{"q":"Qual cor significa 'preto' ?","a":"Noir","opts":["Blanc","Noir","Vert","Bleu"]},{"q":"'Une robe ___' (rosa)","a":"rose","opts":["rose","roses","rouge","rosée"]}],"speak":["La voiture est rouge.","J'aime le bleu.","Le chat noir dort.","Une fleur jaune et orange.","Ma robe préférée est verte."]}