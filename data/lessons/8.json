{"id":8,"title":"Past Simple — Irregular Verbs","emoji":"🔄","verbs":["Go→Went","See→Saw","Make→Made","Take→Took"],"vocab":[{"en":"Airport","pt":"Aeroporto"},{"en":"Hotel","pt":"Hotel"},{"en":"Ticket","pt":"Passagem/Bilhete"},{"en":"Luggage","pt":"Bagagem"},{"en":"Flight","pt":"Voo"},{"en":"Reservation","pt":"Reserva"},{"en":"Client","pt":"Cliente"},{"en":"Report","pt":"Relatório"},{"en":"Email","pt":"E-mail"},{"en":"Schedule","pt":"Agenda/Cronograma"},{"en":"Manager","pt":"Gerente"},{"en":"Early","pt":"Cedo"},{"en":"Late","pt":"Tarde"},{"en":"Ready","pt":"Pronto"},{"en":"Check-in","pt":"Check-in"},{"en":"Meeting","pt":"Reunião"},{"en":"Office","pt":"Escritório"},{"en":"Project","pt":"Projeto"},{"en":"Call","pt":"Ligação"},{"en":"Tomorrow","pt":"Amanhã"},{"en":"Yesterday","pt":"Ontem"},{"en":"Trip","pt":"Viagem"},{"en":"Conference","pt":"Conferência"},{"en":"Deadline","pt":"Prazo"},{"en":"Presentation","pt":"Apresentação"},{"en":"Budget","pt":"Orçamento"},{"en":"Contract","pt":"Contrato"},{"en":"Deal","pt":"Negócio/Acordo"},{"en":"Partner","pt":"Parceiro"},{"en":"Colleague","pt":"Colega"}],"expressions":[{"expr":"Nice to meet you.","meaning":"Prazer em conhecê-lo(a).","example":"Nice to meet you! I went to your office last week."},{"expr":"Can you help me?","meaning":"Você pode me ajudar?","example":"Can you help me? I need to go to the hotel."},{"expr":"Let's get started.","meaning":"Vamos começar.","example":"Let's get started. I made a plan for today."},{"expr":"Have a good trip.","meaning":"Faça uma boa viagem.","example":"Have a good trip! See you when you get back."}],"sentences":["I went to the office yesterday.","She saw the manager this morning.","We made a reservation at the hotel.","He took the luggage to the room.","They went to the airport early.","I saw the email last night.","Did she make a report?","I didn't take the bus."],"grammar":{"title":"Simple Past — Verbos Irregulares","rules":["Verbos irregulares <b>mudam completamente</b> de forma — é preciso memorizar!","Com <b>did/didn't</b>, o verbo volta ao infinitivo: She didn't <b>make</b> (não \"made\")"],"table":{"headers":["Infinitivo","Passado","Negativo","Pergunta"],"rows":[["go","went","didn't go","Did you go?"],["see","saw","didn't see","Did she see?"],["make","made","didn't make","Did he make?"],["take","took","didn't take","Did they take?"],["have","had","didn't have","Did we have?"],["come","came","didn't come","Did it come?"],["get","got","didn't get","Did you get?"],["give","gave","didn't give","Did she give?"]]}},"quiz":[{"q":"I ___ to the airport yesterday. (go)","a":"went","opts":["goed","gone","went","go"]},{"q":"She ___ the manager this morning. (see)","a":"saw","opts":["seen","saw","seed","see"]},{"q":"We ___ a reservation. (make)","a":"made","opts":["maked","make","made","making"]},{"q":"He ___ the luggage. (take)","a":"took","opts":["taked","take","taken","took"]},{"q":"I ___ make the report. (negative)","a":"didn't","opts":["don't","doesn't","didn't","wasn't"]}],"speak":["I went to the airport.","She made a reservation.","Did you see the email?","We took the bus.","He didn't go to the meeting."],"lang":"en"}