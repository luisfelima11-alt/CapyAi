{"id":903,"title":"Tengo treinta años","emoji":"🔢","objective":"Dizer a idade, quantidades simples e pedir um contato.","verbs":["tener","contar","repetir","dar"],"vocab":[{"en":"uno","pt":"um"},{"en":"dos","pt":"dois"},{"en":"tres","pt":"três"},{"en":"cuatro","pt":"quatro"},{"en":"cinco","pt":"cinco"},{"en":"diez","pt":"dez"},{"en":"veinte","pt":"vinte"},{"en":"treinta","pt":"trinta"},{"en":"edad","pt":"idade"},{"en":"número","pt":"número"}],"expressions":[{"expr":"¿Cuántos años tienes?","meaning":"Quantos anos você tem?","example":"¿Cuántos años tienes? Tengo treinta años."},{"expr":"Mi número es…","meaning":"Meu número é…","example":"Mi número es uno, dos, tres."},{"expr":"¿Puedes repetir?","meaning":"Pode repetir?","example":"Perdón, ¿puedes repetir?"}],"sentences":["Tengo treinta años.","¿Cuántos años tienes?","Hay dos personas.","Necesito tres copias.","Mi número es uno, dos, tres.","¿Puedes repetir, por favor?"],"grammar":{"title":"Tener para idade e hay para existência","rules":["Idade usa <b>tener</b>, não ser: <b>Tengo treinta años</b>.","<b>Hay</b> significa há / tem no sentido de existir e não muda entre singular e plural: Hay una persona. Hay dos personas.","Depois de quantidade maior que um, forme o plural: <b>dos personas</b>, <b>tres copias</b>."],"table":{"headers":["Pessoa / situação","Exemplo","Português"],"rows":[["Yo","Tengo treinta años.","Tenho trinta anos."],["Tú","¿Tienes veinte años?","Você tem vinte anos?"],["Existência singular","Hay una persona.","Há uma pessoa."],["Existência plural","Hay dos personas.","Há duas pessoas."]]}},"quiz":[{"q":"Como dizer “Tenho trinta anos”?","a":"Tengo treinta años.","opts":["Soy treinta años.","Estoy treinta años.","Hay treinta años.","Tengo treinta años."],"why":"Idade usa tener."},{"q":"Quanto é “veinte”?","a":"Vinte","opts":["Vinte","Dez","Trinta","Cinco"],"why":"Veinte é vinte."},{"q":"Como dizer “Há duas pessoas”?","a":"Hay dos personas.","opts":["Hay dos persona.","Hay dos personas.","Tengo dos personas.","Es dos personas."],"why":"Hay não muda; o substantivo vai ao plural."},{"q":"Como pedir que alguém repita?","a":"¿Puedes repetir?","opts":["¿Cuántos años tienes?","¿Cómo te llamas?","¿Puedes repetir?","¿De dónde eres?"],"why":"Puedes repetir pede repetição."},{"q":"Qual pergunta pede a idade?","a":"¿Cuántos años tienes?","opts":["¿Cuál es tu nombre?","¿Dónde vives?","¿Qué tal?","¿Cuántos años tienes?"],"why":"Cuántos años pergunta a idade."}],"speak":["Tengo treinta años.","Hay dos personas.","Necesito tres copias.","¿Puedes repetir, por favor?"],"lang":"es","course":"spanish","level":"A1","focus":"Tener para idade e hay para existência"}