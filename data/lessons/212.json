{"id":212,"title":"Le Passé Composé","emoji":"⏪","lang":"fr","verbs":["Avoir mangé","Avoir fait","Avoir vu","Être allé"],"vocab":[{"en":"Hier","pt":"Ontem"},{"en":"J'ai mangé","pt":"Eu comi"},{"en":"J'ai fait","pt":"Eu fiz"},{"en":"J'ai vu","pt":"Eu vi"},{"en":"Je suis allé(e)","pt":"Eu fui"},{"en":"J'ai parlé","pt":"Eu falei"},{"en":"Déjà","pt":"Já"},{"en":"La semaine dernière","pt":"Semana passada"}],"expressions":[{"expr":"Hier soir","meaning":"Ontem à noite.","example":"Hier soir, j'ai vu un film."},{"expr":"Il y a deux jours","meaning":"Há dois dias.","example":"Il y a deux jours, j'ai parlé à Marie."},{"expr":"J'ai déjà fait","meaning":"Eu já fiz.","example":"J'ai déjà fait mes devoirs."},{"expr":"Pas encore","meaning":"Ainda não.","example":"Tu as mangé ? — Non, pas encore."}],"sentences":["Hier, j'ai mangé une pizza.","La semaine dernière, j'ai vu mes amis.","Il a fait ses devoirs.","Nous avons parlé au téléphone.","Elle est allée au cinéma.","Je suis allé à Paris.","Ils ont déjà mangé.","Tu as fait du sport hier ?"],"grammar":{"title":"Le Passé Composé (Pretérito Perfeito)","rules":["Estrutura: <b>auxiliar (avoir/être) no presente</b> + <b>particípio passado</b>.","A maioria dos verbos usa <b>avoir</b>: j'ai mangé, tu as vu, il a fait.","Verbos de movimento e reflexivos usam <b>être</b>: je suis allé(e), elle est venue.","Com <b>être</b>, o particípio concorda em gênero e número com o sujeito."],"table":{"headers":["Verbo","Auxiliar","Exemplo"],"rows":[["manger","avoir","J'ai mangé."],["faire","avoir","J'ai fait."],["voir","avoir","J'ai vu."],["aller","être","Je suis allé(e)."],["parler","avoir","J'ai parlé."]]}},"quiz":[{"q":"'Hier, j'___ une pizza.' (comer - passé composé)","a":"ai mangé","opts":["mange","ai mangé","suis mangé","mangeais"]},{"q":"Qual auxiliar para 'aller' ?","a":"être","opts":["avoir","être","faire","aller"]},{"q":"'Elle ___ au cinéma.' (ir - passé composé)","a":"est allée","opts":["a allé","est allée","est allé","a allée"]},{"q":"Como se diz 'ontem' em francês?","a":"Hier","opts":["Demain","Aujourd'hui","Hier","Maintenant"]},{"q":"'Nous ___ parlé.' (auxiliar correto)","a":"avons","opts":["sommes","avons","êtes","ont"]}],"speak":["Hier, j'ai mangé au restaurant.","La semaine dernière, je suis allé à Paris.","Tu as vu ce film ?","Nous avons parlé pendant deux heures.","Elle a déjà fait ses devoirs."]}