{"id":10,"title":"Quantifiers: Many, Much, More","emoji":"🔢","verbs":["Many","Much","More","A lot of"],"vocab":[{"en":"Many","pt":"Muitos/Muitas (contável)"},{"en":"Much","pt":"Muito/Muita (incontável)"},{"en":"More","pt":"Mais (comparação/adicional)"},{"en":"A lot of","pt":"Muito/Muitos (ambos)"},{"en":"A few","pt":"Alguns/uns poucos (contável)"},{"en":"A little","pt":"Um pouco (incontável)"},{"en":"Some","pt":"Alguns/um pouco (afirmativo)"},{"en":"Any","pt":"Algum/nenhum (neg/interr)"},{"en":"Enough","pt":"Suficiente"},{"en":"Too much","pt":"Muito demais"},{"en":"Too many","pt":"Muitos demais"},{"en":"Sugar","pt":"Açúcar"},{"en":"Water","pt":"Água"},{"en":"Milk","pt":"Leite"},{"en":"Rice","pt":"Arroz"},{"en":"Bread","pt":"Pão"},{"en":"Time","pt":"Tempo"},{"en":"Money","pt":"Dinheiro"},{"en":"Space","pt":"Espaço"},{"en":"Traffic","pt":"Trânsito"},{"en":"Experience","pt":"Experiência"},{"en":"Information","pt":"Informação"},{"en":"Homework","pt":"Tarefa"},{"en":"Questions","pt":"Perguntas"},{"en":"Friends","pt":"Amigos"},{"en":"Books","pt":"Livros"},{"en":"Pages","pt":"Páginas"},{"en":"Times","pt":"Vezes"},{"en":"Places","pt":"Lugares"},{"en":"People","pt":"Pessoas"}],"expressions":[{"expr":"That's too much.","meaning":"Isso é demais.","example":"That's too much work for one day!"},{"expr":"A little bit.","meaning":"Um pouquinho.","example":"Can I have a little bit more water?"},{"expr":"How many/much...?","meaning":"Quantos/Quanta...?","example":"How many books do you have? How much sugar?"},{"expr":"Not enough.","meaning":"Não suficiente.","example":"I don't have enough time to finish."}],"sentences":["How much money do you have?","There are many people at the party.","I don't have much time.","Do you want more coffee?","She has a lot of friends.","I have a lot of work today.","There isn't much milk.","How many pages does this book have?"],"grammar":{"title":"Countable vs. Uncountable Nouns","rules":["<b>MANY</b> → usa com substantivos <b>contáveis</b> (que têm plural): many books, many friends","<b>MUCH</b> → usa com substantivos <b>incontáveis</b> (sem plural): much water, much time","<b>A LOT OF</b> → funciona com <b>ambos</b>: a lot of books / a lot of water","<b>MORE</b> → comparação ou quantidade adicional (ambos): more books / more water"],"table":{"headers":["","Contável (books)","Incontável (water)"],"rows":[["✓ Afirmativo","many books / a lot of books","much water / a lot of water"],["? Pergunta","How many books?","How much water?"],["✗ Negativo","not many books","not much water"],["+ Mais","more books","more water"]]}},"quiz":[{"q":"How ___ money do you have?","a":"much","opts":["many","much","more","lot"]},{"q":"There are ___ people at the party.","a":"many","opts":["much","many","more","lot of"]},{"q":"I have ___ of work today.","a":"a lot","opts":["many","much","a lot","more"]},{"q":"Do you want ___ coffee? (adicional)","a":"more","opts":["many","much","more","some"]},{"q":"There isn't ___ milk in the fridge.","a":"much","opts":["many","much","more","a lot"]}],"speak":["How much water do you drink?","I have many friends.","She needs more time.","There isn't much sugar.","How many books do you have?"],"lang":"en"}