{"id":1003,"title":"Ho trent’anni","emoji":"🔢","objective":"Informar idade, quantidades e pedir que repitam um número.","verbs":["avere","contare","ripetere","dare"],"vocab":[{"en":"uno","pt":"um"},{"en":"due","pt":"dois"},{"en":"tre","pt":"três"},{"en":"quattro","pt":"quatro"},{"en":"cinque","pt":"cinco"},{"en":"dieci","pt":"dez"},{"en":"venti","pt":"vinte"},{"en":"trenta","pt":"trinta"},{"en":"età","pt":"idade"},{"en":"numero","pt":"número"}],"expressions":[{"expr":"Quanti anni hai?","meaning":"Quantos anos você tem?","example":"Quanti anni hai? Ho trenta anni."},{"expr":"Il mio numero è…","meaning":"Meu número é…","example":"Il mio numero è uno, due, tre."},{"expr":"Puoi ripetere?","meaning":"Pode repetir?","example":"Scusa, puoi ripetere?"}],"sentences":["Ho trenta anni.","Quanti anni hai?","Ci sono due persone.","Mi servono tre copie.","Il mio numero è uno, due, tre.","Puoi ripetere, per favore?"],"grammar":{"title":"Avere para idade e c’è / ci sono","rules":["Idade usa <b>avere</b>: Ho trenta anni. Também é comum escrever e dizer <b>ho trent’anni</b>.","<b>C’è</b> significa há no singular; <b>ci sono</b>, no plural: C’è una persona. Ci sono due persone.","O plural não costuma usar -s: persona → <b>persone</b>; copia → <b>copie</b>."],"table":{"headers":["Forma","Exemplo","Português"],"rows":[["Io ho","Ho trenta anni.","Tenho trinta anos."],["Tu hai","Quanti anni hai?","Quantos anos você tem?"],["Singular","C’è una persona.","Há uma pessoa."],["Plural","Ci sono due persone.","Há duas pessoas."]]}},"quiz":[{"q":"Como dizer “Tenho trinta anos”?","a":"Ho trenta anni.","opts":["Sono trenta anni.","Sto trenta anni.","Ci sono trenta anni.","Ho trenta anni."],"why":"A idade usa avere: ho."},{"q":"O que significa “venti”?","a":"Vinte","opts":["Vinte","Dez","Trinta","Cinco"],"why":"Venti é vinte."},{"q":"Como dizer “Há duas pessoas”?","a":"Ci sono due persone.","opts":["C’è due persone.","Ci sono due persone.","Sono due persona.","Ho due persone."],"why":"Para existência no plural, use ci sono."},{"q":"Como pedir repetição informalmente?","a":"Puoi ripetere?","opts":["Quanti anni hai?","Come ti chiami?","Puoi ripetere?","Dove abiti?"],"why":"Puoi ripetere pede que a pessoa repita."},{"q":"Qual é o plural de “persona”?","a":"Persone","opts":["Personas","Personi","Persona","Persone"],"why":"O plural de persona é persone."}],"speak":["Ho trenta anni.","Quanti anni hai?","Ci sono due persone.","Puoi ripetere, per favore?"],"lang":"it","course":"italian","level":"A1","focus":"Avere para idade e c’è / ci sono"}