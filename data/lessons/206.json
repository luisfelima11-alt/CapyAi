{"id":206,"title":"La Nourriture","emoji":"🥐","lang":"fr","verbs":["Manger","Boire","Cuisiner","Goûter"],"vocab":[{"en":"Le pain","pt":"O pão"},{"en":"Le fromage","pt":"O queijo"},{"en":"L'eau","pt":"A água"},{"en":"La pomme","pt":"A maçã"},{"en":"Le café","pt":"O café"},{"en":"Le lait","pt":"O leite"},{"en":"La viande","pt":"A carne"},{"en":"Les légumes","pt":"Os legumes"}],"expressions":[{"expr":"Bon appétit !","meaning":"Bom apetite!","example":"Le repas est prêt, bon appétit !"},{"expr":"J'ai très faim","meaning":"Estou com muita fome.","example":"Après le sport, j'ai très faim."},{"expr":"C'est délicieux","meaning":"Está delicioso.","example":"Ce fromage, c'est délicieux !"},{"expr":"À table !","meaning":"À mesa! (Vamos comer!)","example":"Les enfants, à table !"}],"sentences":["Je mange du pain.","Elle boit de l'eau.","Nous aimons le fromage.","Le café est chaud.","Tu manges une pomme.","Les légumes sont frais.","Il boit du lait le matin.","La viande est bonne."],"grammar":{"title":"Os Artigos Partitivos (du, de la, de l')","rules":["Usados para indicar uma <b>quantidade indefinida</b> de algo (um pouco de).","<b>du</b> + masculino: du pain, du café | <b>de la</b> + feminino: de la viande.","<b>de l'</b> antes de vogal: de l'eau, de l'huile.","Na negativa, todos viram <b>de</b>: Je ne mange pas <b>de</b> pain."],"table":{"headers":["Artigo","Uso","Exemplo"],"rows":[["du","masc.","Je mange du pain."],["de la","fem.","Je bois de la limonade."],["de l'","vogal","Je bois de l'eau."],["des","plural","Je mange des légumes."]]}},"quiz":[{"q":"Como se diz 'o pão' em francês?","a":"Le pain","opts":["Le pain","Le fromage","Le lait","La viande"]},{"q":"'Je bois ___ eau.' (artigo correto)","a":"de l'","opts":["du","de la","de l'","des"]},{"q":"'Je mange ___ pain.'","a":"du","opts":["du","de la","de l'","des"]},{"q":"Como se diz 'a maçã' em francês?","a":"La pomme","opts":["Le pain","La pomme","La poire","Le pomme"]},{"q":"'Les ___ sont frais.' (legumes)","a":"légumes","opts":["fromages","légumes","viandes","pains"]}],"speak":["Je mange du pain et du fromage.","Bon appétit !","Tu veux du café ?","L'eau est froide.","J'aime les légumes verts."]}