{"id":16,"title":"Health & Wellness","emoji":"🏥","verbs":["To Feel / Felt","To Eat / Ate","To Sleep / Slept","To Drink / Drank"],"vocab":[{"en":"Health","pt":"Saúde"},{"en":"Body","pt":"Corpo"},{"en":"Head","pt":"Cabeça"},{"en":"Stomach","pt":"Estômago"},{"en":"Heart","pt":"Coração"},{"en":"Muscle","pt":"Músculo"},{"en":"Pain","pt":"Dor"},{"en":"Headache","pt":"Dor de cabeça"},{"en":"Fever","pt":"Febre"},{"en":"Cold","pt":"Resfriado"},{"en":"Flu","pt":"Gripe"},{"en":"Medicine","pt":"Remédio"},{"en":"Doctor","pt":"Médico"},{"en":"Appointment","pt":"Consulta"},{"en":"Hospital","pt":"Hospital"},{"en":"Pharmacy","pt":"Farmácia"},{"en":"Healthy food","pt":"Comida saudável"},{"en":"Junk food","pt":"Comida não saudável"},{"en":"Fruit","pt":"Fruta"},{"en":"Vegetables","pt":"Legumes/Verduras"},{"en":"Water","pt":"Água"},{"en":"Exercise","pt":"Exercício"},{"en":"Gym","pt":"Academia"},{"en":"Running","pt":"Corrida"},{"en":"Sleep","pt":"Sono"},{"en":"Stress","pt":"Estresse"},{"en":"Energy","pt":"Energia"},{"en":"Lifestyle","pt":"Estilo de vida"},{"en":"Diet","pt":"Dieta"},{"en":"Recovery","pt":"Recuperação"}],"expressions":[{"expr":"I'm under the weather.","meaning":"Estou me sentindo mal.","example":"I can't come today — I'm a bit under the weather."},{"expr":"Take it easy.","meaning":"Descanse / Vá com calma.","example":"You worked too hard. Take it easy this weekend."},{"expr":"I need a check-up.","meaning":"Preciso de um check-up.","example":"I haven't been to the doctor in a year — I need a check-up."},{"expr":"Sleep it off.","meaning":"Dormir para melhorar.","example":"You have a cold? Just sleep it off and drink water."}],"sentences":["I felt tired all day yesterday.","She ate healthy food last week.","He slept for ten hours after the trip.","We drank a lot of water during exercise.","Did you feel better after the medicine?","I didn't eat breakfast this morning.","She exercised every day last month.","They recovered quickly from the flu."],"grammar":{"title":"Simple Past — Verbos Irregulares de Saúde","rules":["Estes verbos mudam completamente no passado — é preciso memorizar!","feel → <b>felt</b> | eat → <b>ate</b> | sleep → <b>slept</b> | drink → <b>drank</b>","Com <b>didn't</b>, o verbo volta ao infinitivo: \"I didn't <b>eat</b>\" (não \"ate\")","Dica: exercised, recovered, rested são regulares → apenas adicione <b>-ed</b>"],"table":{"headers":["Infinitivo","Passado","Negativo"],"rows":[["feel","felt","didn't feel"],["eat","ate","didn't eat"],["sleep","slept","didn't sleep"],["drink","drank","didn't drink"],["recover","recovered","didn't recover"]]}},"quiz":[{"q":"She ___ very tired yesterday. (feel)","a":"felt","opts":["feeled","feel","felt","feeling"]},{"q":"I ___ healthy food all week. (eat)","a":"ate","opts":["eated","eat","ate","eating"]},{"q":"He ___ for 9 hours last night. (sleep)","a":"slept","opts":["sleeped","sleep","slept","sleeping"]},{"q":"We ___ drink enough water. (negative)","a":"didn't","opts":["don't","doesn't","didn't","weren't"]},{"q":"___ you feel better after the medicine?","a":"Did","opts":["Have","Did","Does","Were"]}],"speak":["I felt sick yesterday.","She ate a lot of fruit.","Did you sleep well?","He drank water after the gym.","We didn't eat junk food."],"lang":"en"}