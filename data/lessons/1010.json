{"id":1010,"title":"Al supermercato","emoji":"🛒","objective":"Comprar alimentos, pedir quantidades e perguntar onde fica um produto.","verbs":["comprare","servire","costare","prendere"],"vocab":[{"en":"mela","pt":"maçã"},{"en":"riso","pt":"arroz"},{"en":"uovo","pt":"ovo"},{"en":"formaggio","pt":"queijo"},{"en":"pomodoro","pt":"tomate"},{"en":"chilo","pt":"quilo"},{"en":"bottiglia","pt":"garrafa"},{"en":"sacchetto","pt":"sacola"},{"en":"prezzo","pt":"preço"},{"en":"cassa","pt":"caixa de pagamento"}],"expressions":[{"expr":"Un chilo di…","meaning":"Um quilo de…","example":"Vorrei un chilo di pomodori."},{"expr":"Dove sono…?","meaning":"Onde estão…?","example":"Dove sono le uova?"},{"expr":"Quanto costano…?","meaning":"Quanto custam…?","example":"Quanto costano queste mele?"}],"sentences":["Devo comprare il riso.","Vorrei un chilo di pomodori.","Dove sono le uova?","Quanto costano queste mele?","Prendo due bottiglie d’acqua.","Non mi serve un sacchetto."],"grammar":{"title":"Quantidades com di e plurais de alimentos","rules":["Use <b>di</b> depois da medida: un chilo di pomodori. Antes de acqua, é comum a elisão: <b>una bottiglia d’acqua</b>.","<b>Quanto costa?</b> pergunta por um item; <b>quanto costano?</b>, por vários: Quanto costano le mele?","Observe o plural irregular: <b>l’uovo → le uova</b>. Também: il pomodoro → i pomodori; la mela → le mele."],"table":{"headers":["Singular","Plural / quantidade","Português"],"rows":[["l’uovo","le uova","ovo / ovos"],["il pomodoro","i pomodori","tomate / tomates"],["la mela","le mele","maçã / maçãs"],["la bottiglia","due bottiglie d’acqua","duas garrafas de água"]]}},"quiz":[{"q":"Complete: Un chilo ___ pomodori.","a":"di","opts":["a","con","di","in"],"why":"A medida liga-se ao alimento por di."},{"q":"Como perguntar o preço de várias maçãs?","a":"Quanto costano queste mele?","opts":["Quanto costa queste mele?","Come costa queste mele?","Dove costi queste mele?","Quanto costano queste mele?"],"why":"Mele é plural, por isso costano."},{"q":"Qual é o plural de “l’uovo”?","a":"Le uova","opts":["Le uova","Gli uovi","I uovos","La uova"],"why":"Uovo tem o plural irregular le uova."},{"q":"“Non mi serve un sacchetto” significa:","a":"Não preciso de sacola","opts":["Quero duas sacolas","Não preciso de sacola","O caixa está fechado","Preciso de um quilo de arroz"],"why":"Non mi serve indica que não é necessário para mim."},{"q":"Qual palavra significa queijo?","a":"Formaggio","opts":["Riso","Mela","Formaggio","Cassa"],"why":"Formaggio é queijo."}],"speak":["Vorrei un chilo di pomodori.","Dove sono le uova?","Quanto costano queste mele?","Non mi serve un sacchetto."],"lang":"it","course":"italian","level":"A1","focus":"Quantidades com di e plurais de alimentos"}