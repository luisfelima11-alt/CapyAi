{"id":12,"title":"Future: Will & Going to","emoji":"🔮","verbs":["Will + verb","Am/Is/Are going to + verb","Shall","Won't (will not)"],"vocab":[{"en":"Tomorrow","pt":"Amanhã"},{"en":"Next week","pt":"Próxima semana"},{"en":"Next year","pt":"Próximo ano"},{"en":"Soon","pt":"Em breve"},{"en":"Later","pt":"Mais tarde"},{"en":"In the future","pt":"No futuro"},{"en":"Plan","pt":"Plano"},{"en":"Intention","pt":"Intenção"},{"en":"Promise","pt":"Promessa"},{"en":"Prediction","pt":"Previsão"},{"en":"Decision","pt":"Decisão"},{"en":"Dream","pt":"Sonho"},{"en":"Goal","pt":"Meta"},{"en":"Hope","pt":"Esperança"},{"en":"Expect","pt":"Esperar/Prever"},{"en":"Probably","pt":"Provavelmente"},{"en":"Maybe","pt":"Talvez"},{"en":"Definitely","pt":"Definitivamente"},{"en":"Graduate","pt":"Formarse"},{"en":"Marry","pt":"Casar"},{"en":"Move","pt":"Mudar-se"},{"en":"Buy","pt":"Comprar"},{"en":"Sell","pt":"Vender"},{"en":"Build","pt":"Construir"},{"en":"Travel","pt":"Viajar"},{"en":"Learn","pt":"Aprender"},{"en":"Earn","pt":"Ganhar"},{"en":"Save","pt":"Economizar"},{"en":"Start","pt":"Começar"},{"en":"Retire","pt":"Aposentar-se"}],"expressions":[{"expr":"I'll think about it.","meaning":"Vou pensar a respeito.","example":"Should I take the job? I'll think about it."},{"expr":"It's going to be great.","meaning":"Vai ser ótimo.","example":"Don't worry, it's going to be great!"},{"expr":"One day...","meaning":"Um dia...","example":"One day, I will speak English perfectly."},{"expr":"Before you know it.","meaning":"Antes que você perceba.","example":"Study every day and before you know it, you'll be fluent."}],"sentences":["I'll call you tomorrow.","She is going to study tonight.","They will travel to London next year.","We are going to buy a new car.","It's going to rain today.","I will never give up.","Will you help me?","Is she going to be there?"],"grammar":{"title":"Will vs. Going to","rules":["<b>WILL</b>: decisão espontânea, promessa, previsão sem evidência: \"I'll help you!\" (agora decidi)","<b>GOING TO</b>: plano já decidido, intenção, previsão com evidência: \"I'm going to study\" (já planejei)","Estrutura WILL: [Sujeito] + will + [infinitivo sem to]","Estrutura GOING TO: [Sujeito] + am/is/are + going to + [infinitivo sem to]"],"table":{"headers":["","Will","Going to"],"rows":[["Afirmativo","I will go.","I am going to go."],["Negativo","I won't go.","I'm not going to go."],["Pergunta","Will you go?","Are you going to go?"],["Uso","Decisão espontânea / promessa","Plano já feito / intenção"]]}},"quiz":[{"q":"Look at those clouds. It ___ rain. (evidência)","a":"is going to","opts":["will","is going to","going to","shall"]},{"q":"Hold on, ___ help you. (decisão espontânea)","a":"I'll","opts":["I'm going to","I'll","I shall to","I am will"]},{"q":"She ___ travel to London next month. (plano)","a":"is going to","opts":["will","is going to","goes to","shall"]},{"q":"___ you help me? (pedido com will)","a":"Will","opts":["Shall","Going to","Will","Are"]},{"q":"They ___ (will + neg) give up.","a":"won't","opts":["don't will","won't","not will","willn't"]}],"speak":["I'll call you later.","She is going to study tonight.","Will you come to the party?","We won't give up.","It's going to be a great day!"],"lang":"en"}