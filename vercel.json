{
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/",           "destination": "/4_Login_Capy_Yara_Welcomes_You.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control",     "value": "no-store, no-cache, must-revalidate, proxy-revalidate, s-maxage=0" },
        { "key": "Pragma",            "value": "no-cache" },
        { "key": "Expires",           "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    }
  ]
}
