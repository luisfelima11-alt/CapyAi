{
  "name": "capy-yara-adventures",
  "version": "1.0.0",
  "description": "Capy Yara Adventures — local dev: node scripts/dev-server.js",
  "scripts": {
    "audit": "node scripts/audit-lessons.js",
    "audit:local": "node scripts/audit-lessons.js --base=http://localhost:8765",
    "audit:debug": "node scripts/audit-lessons.js --headless=false",
    "test:security": "node --test tests/security.test.js",
    "test:turkish": "node --test tests/turkish-course.test.js",
    "test:e2e:security": "playwright test --config=playwright.config.js",
    "security:check": "npm audit --audit-level=high && npm run test:security",
    "auth:migrate:dry-run": "node scripts/migrate-to-supabase-auth.js",
    "build:security-assets": "node scripts/externalize-security-pages.js && tailwindcss -c tailwind.security.config.js -i assets/css/security-pages.input.css -o assets/css/security-pages.css --minify",
    "bump": "node scripts/bump-versions.js",
    "patch-aulas": "node scripts/patch-legacy-aulas.js",
    "test:streak": "node --test tests/streak-br.test.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "playwright": "^1.45.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "web-push": "^3.6.7"
  }
}
