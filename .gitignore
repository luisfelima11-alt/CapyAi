.env
.env.local
# Qualquer .env baixado da Vercel (env pull) — nunca commitar.
# ATENÇÃO: o .gitignore NÃO aceita comentário no fim da linha do padrão. Se
# escrever `.env.*   # comentário`, o padrão vira a linha inteira e deixa de
# ignorar coisa nenhuma — foi exatamente o que aconteceu aqui, e o
# `.env.producao` ficou desprotegido sem ninguém notar.
.env.*
!.env.example
node_modules/
.vercel/
database.json
security-audit-private/
test-results/
playwright-report/

.vercel

# Backups locais (api/index.js.bak etc.) — nunca versionar
*.bak

# Logs locais (o server.log chegou a ser versionado)
*.log
# Fotos de dados de alunos geradas por scripts: dado pessoal, nunca no repo
scripts/_foto-*.json
# Estado local da CLI do Supabase
supabase/.temp/
# Chaves e certificados (inclui a chave de assinatura do app Android)
*.pem
*.key
*.p12
*.keystore
*.jks
